{
  "name": "my-patina",
  "version": "0.1.0",
  "description": "Personal professional knowledge graph — setup and management",
  "type": "module",
  "bin": {
    "my-patina": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-templates.mjs",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "chalk": "^5.3.0",
    "js-yaml": "^4.1.0",
    "tsup": "^8.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "tsup": {
    "entry": ["src/cli.ts"],
    "format": ["esm"],
    "clean": true,
    "banner": {
      "js": "#!/usr/bin/env node"
    }
  },
  "files": ["dist/"],
  "keywords": ["patina", "career", "knowledge-graph", "cli"],
  "license": "MIT"
}
