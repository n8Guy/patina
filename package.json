{
  "name": "my-patina",
  "version": "0.24.2",
  "description": "Personal professional knowledge graph — setup and management",
  "type": "module",
  "bin": {
    "my-patina": "dist/check-node.cjs"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-templates.mjs",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "tsup": {
    "entry": [
      "src/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "clean": true,
    "banner": {
      "js": "#!/usr/bin/env node"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "patina",
    "career",
    "knowledge-graph",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8Guy/patina.git"
  },
  "bugs": {
    "url": "https://github.com/n8Guy/patina/issues"
  },
  "homepage": "https://github.com/n8Guy/patina#readme"
}
